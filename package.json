{
  "name": "trace-landing-page",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "python -m http.server 8080 -d docs",
    "test": "jest",
    "test:ci": "jest --ci --reporters=default --reporters=jest-junit --reporters=jest-html-reporter",
    "lint:html": "htmlhint \"docs/*.html\"",
    "lint": "npm run lint:html",
    "check": "npm test && npm run lint"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "jest-junit.xml",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}",
    "ancestorSeparator": " › "
  },
  "devDependencies": {
    "htmlhint": "^1.1.4",
    "jest": "^29.7.0",
    "jsdom": "^29.0.1"
  }
}
